#
# Workspace direnv configuration.
#
# Wire it up once per machine (README step 3):
#
#   mkdir -p ~/.config/direnv
#   echo "source \"$PWD/direnvrc\"" > ~/.config/direnv/direnvrc
#
# Tracked here rather than left as a snippet to paste, so a fresh machine gets
# identical behaviour and the reasoning below travels with it.

# nix-direnv caches `use flake` evaluation and - the part that matters more -
# registers a GC root per dev shell, so nix-collect-garbage cannot delete a
# closure you are actively using.
#
# Sourced from the nix profile rather than a pinned store path, so it tracks
# `nix profile upgrade`.
source "$HOME/.nix-profile/share/nix-direnv/direnvrc"

# ---------------------------------------------------------------------------
# Redirect an upstream `use nix` to the workspace's own dev shell.
#
# Some org repos TRACK their own .envrc. firmware's contains `use nix`, which
# resolves through firmware/shell.nix -> flake-compat -> firmware's own
# flake.nix, whose devShell uses pkgs.platformio: the bubblewrap-wrapped build
# that cannot run on an Ubuntu host with
# apparmor_restrict_unprivileged_userns=1. Every pio invocation then dies with
# "bwrap: setting up uid map: Permission denied" - the exact failure this
# workspace pins platformio-core to avoid.
#
# Editing that file is not an option. It is tracked, so overwriting it would
# leave the repo permanently dirty (which blocks `nix run .#sync -- --pull`)
# and could be committed into an org PR by accident.
#
# So `nix run .#sync` writes an untracked .envrc-workspace sidecar alongside
# the tracked .envrc, and this override prefers it.
#
# Deliberately scoped: with no sidecar present, upstream's `use nix` runs
# exactly as before. Unrelated projects on this machine are unaffected.
# ---------------------------------------------------------------------------
if declare -f use_nix >/dev/null 2>&1; then
  # Rename nix-direnv's implementation rather than discard it, so the
  # fallback below is the real thing. Pure bash: `declare -f` emits
  # "use_nix () \n{ ... }", and stripping the leading name leaves a body that
  # can be re-bound under a new one.
  _meshtastic_use_nix_orig=$(declare -f use_nix)
  eval "_meshtastic_upstream_use_nix${_meshtastic_use_nix_orig#use_nix}"
  unset _meshtastic_use_nix_orig

  use_nix() {
    if [ -f "$PWD/.envrc-workspace" ]; then
      watch_file "$PWD/.envrc-workspace"
      log_status "nixtastic: .envrc-workspace overrides upstream 'use nix'"
      # shellcheck source=/dev/null
      . "$PWD/.envrc-workspace"
      return
    fi
    _meshtastic_upstream_use_nix "$@"
  }
fi

# ---------------------------------------------------------------------------
# The same redirect, for a tracked .envrc that never calls `use nix`.
#
# meshtastic-bot tracks one that sets APP_ENV and loads a dotenv. `nix run
# .#sync` writes it an .envrc-workspace sidecar exactly as it does for
# firmware, but the override above is bound to use_nix and so can never run:
# direnv would load the repo's file, select no dev shell, and `just in
# meshtastic-bot go test ./...` would find whatever go happened to be on PATH.
#
# direnvrc is sourced before the .envrc, so sourcing the sidecar HERE puts the
# shell in place first and lets the repo's own file run on top of it - it adds
# variables, it does not select a toolchain. A missing dotenv target is logged
# and does not abort the load (direnv 2.37.1), so a repo whose .env.<env> has
# not been created still gets its shell.
#
# $PWD, and not the .envrc's directory: direnv sources this file BEFORE
# changing into that directory, and exports neither DIRENV_DIR nor DIRENV_FILE
# yet (measured 2026-09-17), so there is nothing else to key on. That covers
# `cd <repo>` and both justfile recipes, which cd first and then run
# `direnv exec .`. A bare `direnv exec <repo> <cmd>` from somewhere else loads
# the repo's .envrc without the sidecar - no shell, no error. Use `just in
# <repo> <cmd>`.
#
# Gated on the file naming no shell of its own, so firmware keeps taking the
# use_nix path above and nothing is loaded twice.
# ---------------------------------------------------------------------------
if [ -f "$PWD/.envrc-workspace" ] && [ -f "$PWD/.envrc" ] &&
   ! grep -qE '^[[:space:]]*use[ _](nix|flake)' "$PWD/.envrc"; then
  watch_file "$PWD/.envrc-workspace"
  log_status "nixtastic: .envrc-workspace loaded ahead of a tracked .envrc"
  # shellcheck source=/dev/null
  . "$PWD/.envrc-workspace"
fi
