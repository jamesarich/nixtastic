# Workspace root. Requires direnv + nix-direnv.
#
# MESHTASTIC_WORKSPACE is what makes the workspace relocatable: the flake
# uses it to place Gradle caches, and `nix run .#sync` uses it to decide
# where to clone. Everything else is derived from it.
#
# This file is TRACKED, so a linked worktree of the workspace repo carries
# its own copy — which is exactly what an agent harness's worktree
# isolation creates (verified: a worktree under .claude/worktrees/ with the
# tracked files and NONE of the org repos, since those are untracked).
# Pointing MESHTASTIC_WORKSPACE at $PWD there would aim every cache, clone
# and tool at a decoy workspace; `nix run .#sync` would even re-clone all
# ten repos into it. So resolve the MAIN checkout via git instead — in the
# real root the two are identical and nothing changes. `use flake` stays
# bare on purpose: a workspace worktree exists to test ITS OWN flake edits.
MESHTASTIC_WORKSPACE="$PWD"
if command -v git >/dev/null 2>&1; then
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$PWD/.git")"
  main="$(dirname "$common")"
  if [ -d "$main/.git" ] && [ "$main" != "$PWD" ]; then
    MESHTASTIC_WORKSPACE="$main"
  fi
fi
export MESHTASTIC_WORKSPACE

# The workspace tree is dirty almost by definition — ten cloned repos and
# generated files sit inside it — so nix's "Git tree has uncommitted changes"
# on every run is pure noise. NIX_CONFIG rather than the flake's nixConfig:
# an untrusted nixConfig setting just adds a second warning about ignoring
# the first (verified), while the user's own environment needs no trust.
# Non-direnv shells (scripts, agent subshells) can set the same line in
# ~/.config/nix/nix.conf.
export NIX_CONFIG="warn-dirty = false"

use flake

# Per-repo shells are GENERATED, not hand-written:
#
#   nix run .#sync          writes a .envrc into every repo, then prints the
#                           `direnv allow` line for each. Idempotent, and it
#                           never clobbers a file that already exists.
#   nix run .#worktree      does the same for a new worktree.
#
# Do not write them by hand. Two things are easy to get wrong and both fail
# silently:
#
#   1. MESHTASTIC_WORKSPACE must be exported BEFORE `use flake`. nix-direnv
#      runs the flake's shellHook during use_flake, and that hook pins the
#      JDKs and GRADLE_USER_HOME only if the variable is already set. A
#      .envrc with just `use flake ...#android` enters the right shell with
#      the pinning inert — Gradle then auto-provisions its own JDKs.
#   2. Derive the path, never hardcode it. This workspace is relocatable and
#      is verified working from a directory not named "meshtastic"
#      (tested at ~/meshtastic-workspace).
#
# firmware is a special case: it TRACKS its own .envrc containing the legacy
# `use nix`, which resolves to UPSTREAM's flake and its bwrap-broken
# platformio. We never edit a tracked file, so sync writes an untracked
# .envrc-workspace sidecar and ./direnvrc prefers it. See AGENTS.md.
#
# .envrc, .envrc-workspace and .direnv/ are excluded globally via
# ~/.config/git/ignore, so they never appear as untracked files in an org repo.
