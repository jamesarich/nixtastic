# Workspace root. Requires direnv + nix-direnv.
#
# MESHTASTIC_WORKSPACE is what makes the workspace relocatable: the flake
# uses it to place Gradle caches, and `nix run .#sync` uses it to decide
# where to clone. Everything else is derived from it.
export MESHTASTIC_WORKSPACE="$PWD"

use flake

# Per-repo shells: drop a .envrc into each repo. DERIVE the path — do not
# hardcode one. This workspace is relocatable and is verified working from a
# directory not named "meshtastic" (tested at ~/meshtastic-workspace).
#
#   android/.envrc                 use flake "$(dirname "$PWD")#android"
#   firmware/.envrc                use flake "$(dirname "$PWD")#firmware"
#   meshtastic-sdk/.envrc          use flake "$(dirname "$PWD")#kotlin"
#   MQTTastic-Client-KMP/.envrc    use flake "$(dirname "$PWD")#kotlin"
#   kzstd/.envrc                   use flake "$(dirname "$PWD")#kotlin"
#   gradle-flatpak-sources/.envrc  use flake "$(dirname "$PWD")#kotlin"
#   meshtastic-mcp/.envrc          use flake "$(dirname "$PWD")#mcp"
#   protobufs/.envrc               use flake "$(dirname "$PWD")#protobufs"
#   design/.envrc                  use flake "$(dirname "$PWD")#design"
#
# `nix run .#worktree` already generates these correctly for worktrees.
#
# Add .envrc + .direnv/ to your global gitignore so they never show up as
# untracked files in the repos themselves:
#   git config --global core.excludesfile ~/.gitignore
#   printf '.envrc\n.direnv/\n' >> ~/.gitignore
